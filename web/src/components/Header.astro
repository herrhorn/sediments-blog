---
import { SITE_TITLE } from '../consts';
---

<header>
  <a href="/" class="site-title">{SITE_TITLE}</a>
  <nav>
    <a href="/">home</a>
    <a href="/blog">writing</a>
    <a href="/about">about</a>
  </nav>
</header>

<style>
  header {
    max-width:      var(--measure);
    margin:         0 auto;
    padding:        2.5em 1.5em 0;
    display:        flex;
    align-items:    baseline;
    justify-content: space-between;
    gap:            2em;
  }

  .site-title {
    font-weight:      700;
    font-size:        0.95em;
    text-decoration:  none;
    color:            var(--text);
    letter-spacing:   0.02em;
  }

  .site-title:hover {
    text-decoration: none;
  }

  nav {
    display: flex;
    gap:     1.75em;
  }

  nav a {
    font-size:        0.85em;
    color:            var(--muted);
    text-decoration:  none;
  }

  nav a:hover {
    color: var(--text);
  }

  @media (max-width: 600px) {
    header  { flex-direction: column; gap: 0.75em; padding-top: 1.75em; }
    nav     { gap: 1.25em; }
  }
</style>
