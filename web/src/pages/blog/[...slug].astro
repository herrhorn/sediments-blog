---
import { getAllSlugs, getPost } from '../../lib/sanity';
import { portableTextToHtml } from '../../lib/portableText';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const slugs = await getAllSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await getPost(slug!);
if (!post) return Astro.redirect('/blog');

const bodyHtml = post.body ? portableTextToHtml(post.body) : '';
---

<html lang="en">
  <head>
    <BaseHead title={post.title} description={post.excerpt ?? ''} />
  </head>
  <body>
    <Header />
    <main>
      <article>
        <header class="post-header">
          <h1>{post.title}</h1>
          <div class="meta">
            {post.publishedAt && (
              <time datetime={post.publishedAt}>
                {new Date(post.publishedAt).toLocaleDateString('en-us', {
                  year: 'numeric', month: 'long', day: 'numeric'
                })}
              </time>
            )}
            {post.author?.name && <span class="author">{post.author.name}</span>}
          </div>
        </header>

        <hr />

        <div class="prose" set:html={bodyHtml} />
      </article>

      <nav class="post-nav">
        <a href="/blog">&larr; all posts</a>
      </nav>
    </main>
    <Footer />
  </body>
</html>

<style>
  .post-header {
    margin-bottom: 1.5em;
  }

  .post-header h1 {
    font-size:    1.3em;
    margin:       0 0 0.4em;
  }

  .meta {
    display:    flex;
    gap:        1.5em;
    color:      var(--muted);
    font-size:  0.8em;
  }

  .author::before {
    content: '— ';
  }

  /* ── Prose ── */

  .prose {
    margin-top: 2em;
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    margin-top: 2em;
  }

  .prose :global(p) {
    margin: 0 0 1.5em;
  }

  .prose :global(a) {
    color: var(--text);
  }

  .prose :global(img) {
    max-width:    100%;
    margin:       1.5em 0;
    border-radius: 3px;
  }

  .prose :global(figure) {
    margin: 1.5em 0;
  }

  .prose :global(figcaption) {
    color:      var(--muted);
    font-size:  0.8em;
    margin-top: 0.5em;
  }

  /* ── Back link ── */

  .post-nav {
    margin-top: 3em;
  }

  .post-nav a {
    font-size:        0.85em;
    color:            var(--muted);
    text-decoration:  none;
  }

  .post-nav a:hover {
    color: var(--text);
  }
</style>
